diff --git a/app/src/main/java/df/root/DeviceLock.java b/app/src/main/java/df/root/DeviceLock.java
new file mode 100644
index 0000000..fea3f15
--- /dev/null
+++ b/app/src/main/java/df/root/DeviceLock.java
@@ -0,0 +1,80 @@
+package df.root;
+
+import android.os.Build;
+
+/**
+ * Hard firmware lock for the one target this build was made for:
+ *
+ *   Samsung Galaxy Z Fold7 (Canada) SM-F966W
+ *   Build   CP2A.260605.016.F966WVLUDCZJB  (One UI 9 / Android 17 / SDK 37)
+ *   Kernel  6.6.127-android15-8-p4a765df-abogkiF966USQUDCZJB-4k  (KMI android15-6.6)
+ *
+ * The DirtyFrag kernel module is matched per KMI, not per build, so the exploit
+ * itself would run on other android15-6.6 kernels as well. This lock is a safety
+ * net: it refuses to touch the kernel unless every field matches the device this
+ * APK was produced and reviewed for.
+ *
+ * Kernel strings are compared after normalising runs of whitespace, because some
+ * ROMs report the uname release with a double space before the build timestamp.
+ */
+final class DeviceLock {
+
+    static final String MODEL = "SM-F966W";
+    static final String BUILD_ID = "CP2A.260605.016.F966WVLUDCZJB";
+    // Samsung normally reports ro.build.id without the model suffix
+    // ("CP2A.260605.016") and keeps the full build number in ro.build.display.id.
+    static final String BUILD_ID_SHORT = "CP2A.260605.016";
+    static final String KERNEL_PREFIX =
+            "6.6.127-android15-8-p4a765df-abogkiF966USQUDCZJB-4k";
+    static final String FINGERPRINT_PREFIX =
+            "samsung/q7qcsx/q7q:17/CP2A.260605.016/";
+    static final int SDK_INT = 37;
+
+    private DeviceLock() {}
+
+    static String normalize(String value) {
+        return value == null ? "" : value.trim().replaceAll("\\s+", " ");
+    }
+
+    static String kernelRelease() {
+        return normalize(System.getProperty("os.version", ""));
+    }
+
+    /** @return null when the device matches, otherwise a human readable refusal. */
+    static String check() {
+        StringBuilder bad = new StringBuilder();
+        if (!MODEL.equals(Build.MODEL)) {
+            bad.append("  model: expected ").append(MODEL)
+               .append(", got ").append(Build.MODEL).append('\n');
+        }
+        String display = normalize(Build.DISPLAY);
+        String buildId = normalize(Build.ID);
+        boolean buildOk = BUILD_ID.equals(buildId)
+                || BUILD_ID.equals(display)
+                || (buildId.startsWith(BUILD_ID_SHORT) && display.contains(BUILD_ID));
+        if (!buildOk) {
+            bad.append("  build: expected ").append(BUILD_ID)
+               .append(", got id=").append(buildId)
+               .append(" display=").append(display).append('\n');
+        }
+        if (Build.VERSION.SDK_INT != SDK_INT) {
+            bad.append("  sdk: expected ").append(SDK_INT)
+               .append(", got ").append(Build.VERSION.SDK_INT).append('\n');
+        }
+        String fingerprint = normalize(Build.FINGERPRINT);
+        if (!fingerprint.startsWith(FINGERPRINT_PREFIX)) {
+            bad.append("  fingerprint: expected prefix ").append(FINGERPRINT_PREFIX)
+               .append(", got ").append(fingerprint).append('\n');
+        }
+        String kernel = kernelRelease();
+        if (!kernel.startsWith(KERNEL_PREFIX)) {
+            bad.append("  kernel: expected prefix ").append(KERNEL_PREFIX)
+               .append(", got ").append(kernel).append('\n');
+        }
+        return bad.length() == 0 ? null : bad.toString();
+    }
+
+    static String describe() {
+        return "SM-F966W / " + BUILD_ID + " / KMI android15-6.6 (DirtyFrag)";
+    }
+}
diff --git a/app/src/main/java/df/root/Diagnostics.java b/app/src/main/java/df/root/Diagnostics.java
new file mode 100644
index 0000000..1612ff5
--- /dev/null
+++ b/app/src/main/java/df/root/Diagnostics.java
@@ -0,0 +1,272 @@
+package df.root;
+
+import android.content.Context;
+import android.os.SystemClock;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.RandomAccessFile;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Local build only (not upstream): run-time forensics.
+ *
+ * DFRoot's chain is asynchronous: the Java exploit process exits long before the
+ * libc++ hook fires in init, and bootstrap.c / ksud report progress only through
+ * marker files in /dev. Those markers vanish when the kernel restarts, so a device
+ * that panics leaves no trace of how far it got. This class mirrors everything into
+ * a file in device-protected storage (survives reboot, no unlock needed) so the
+ * outcome of a crashed run can still be read on the next boot.
+ */
+final class Diagnostics {
+
+    private static final String LOG_FILE = "diag.log";
+    private static final long MAX_LOG = 400 * 1024;
+
+    /** Marker files created by lkm/dfroot.c and jni/bootstrap.c. */
+    private static final Map<String, String> MARKERS = new LinkedHashMap<>();
+    static {
+        MARKERS.put("/dev/df",     "shellcode ran in init (ko written, insmod path taken)");
+        MARKERS.put("/dev/dfm0",   "dfroot.ko -> usermodehelper started sh");
+        MARKERS.put("/dev/dfm1",   "bootstrap main() started");
+        MARKERS.put("/dev/dfm2",   "bootstrap read prefs (su_manager found)");
+        MARKERS.put("/dev/dfm3",   "bootstrap: zygote env adopted");
+        MARKERS.put("/dev/dfm4",   "bootstrap: KSU modules disabled");
+        MARKERS.put("/dev/dfm5",   "bootstrap: about to exec ksud late-load");
+        MARKERS.put("/dev/dfm6",   "ksud late-load EXITED 0  (KernelSU really loaded)");
+        MARKERS.put("/dev/dfme0",  "ERROR bootstrap: prefs unreadable / no su_manager");
+        MARKERS.put("/dev/dfme1",  "ERROR bootstrap: disable_modules failed");
+        MARKERS.put("/dev/dfme2",  "ERROR ksud late-load EXITED NONZERO (root not installed)");
+        MARKERS.put("/dev/dfmw0",  "warn bootstrap: adopt_zygote_env failed");
+        MARKERS.put("/dev/dfmw1",  "warn bootstrap: set_partitions_ro failed");
+    }
+
+    /** Verdict codes returned by awaitMarkers(), mapped by ExploitRunner. */
+    static final int VERDICT_KSUD_OK = 0;
+    static final int VERDICT_KSUD_FAIL = 4;
+    static final int VERDICT_STALLED = 5;
+
+    private Diagnostics() {}
+
+    // ---- persistent log -------------------------------------------------------
+
+    static synchronized void log(Context ctx, String msg) {
+        File f = new File(ctx.getFilesDir(), LOG_FILE);
+        try {
+            if (f.exists() && f.length() > MAX_LOG) trimHead(f, MAX_LOG / 2);
+            try (FileOutputStream os = new FileOutputStream(f, true)) {
+                os.write(line(msg).getBytes(StandardCharsets.UTF_8));
+                os.flush();
+                os.getFD().sync();
+            }
+        } catch (Exception ignored) {
+        }
+    }
+
+    private static String line(String msg) {
+        long wall = System.currentTimeMillis();
+        String stamp = new SimpleDateFormat("MM-dd HH:mm:ss.SSS", Locale.US).format(new Date(wall));
+        return String.format(Locale.US, "%s up=%5.1fs %s%n",
+                stamp, SystemClock.uptimeMillis() / 1000.0, msg.trim());
+    }
+
+    private static void trimHead(File f, long keep) throws Exception {
+        try (RandomAccessFile raf = new RandomAccessFile(f, "rw")) {
+            long len = raf.length();
+            if (len <= keep) return;
+            raf.seek(len - keep);
+            while (raf.getFilePointer() < len && raf.read() != '\n') raf.seek(raf.getFilePointer() + 1);
+            byte[] tail = new byte[(int) (len - raf.getFilePointer())];
+            raf.readFully(tail);
+            raf.setLength(0);
+            raf.write(tail);
+        }
+    }
+
+    static synchronized List<String> tail(Context ctx, int n) {
+        File f = new File(ctx.getFilesDir(), LOG_FILE);
+        List<String> out = new ArrayList<>();
+        if (!f.exists()) return out;
+        try (RandomAccessFile raf = new RandomAccessFile(f, "r")) {
+            long pos = raf.length();
+            int lines = 0;
+            while (pos > 0 && lines < n) {
+                pos--;
+                raf.seek(pos);
+                if (raf.read() == '\n') lines++;
+            }
+            raf.seek(pos);
+            byte[] rest = new byte[(int) (raf.length() - pos)];
+            raf.readFully(rest);
+            for (String s : new String(rest, StandardCharsets.UTF_8).split("\\R"))
+                if (!s.isEmpty()) out.add(s);
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+
+    // ---- run boundaries -------------------------------------------------------
+
+    static void runStart(Context ctx, String source) {
+        log(ctx, String.format(Locale.US, "=== RUN START (%s) manager=%s soft_reboot=%s disable_modules=%s /dev/df=%s",
+                source,
+                ctx.getSharedPreferences(ExploitRunner.PREFS_NAME, Context.MODE_PRIVATE)
+                        .getString(ExploitRunner.PREF_SU_MANAGER, "<none>"),
+                ctx.getSharedPreferences(ExploitRunner.PREFS_NAME, Context.MODE_PRIVATE)
+                        .getBoolean(ExploitRunner.PREF_SOFT_REBOOT, false),
+                ctx.getSharedPreferences(ExploitRunner.PREFS_NAME, Context.MODE_PRIVATE)
+                        .getBoolean(ExploitRunner.PREF_DISABLE_MODULES, false),
+                new File("/dev/df").exists()));
+    }
+
+    static void runEnd(Context ctx, String verdict) {
+        log(ctx, "=== RUN END " + verdict + " ===");
+    }
+
+    // ---- boot forensics -------------------------------------------------------
+
+    private static String bootId() {
+        try {
+            return new String(Files.readAllBytes(
+                    new File("/proc/sys/kernel/random/boot_id").toPath())).trim();
+        } catch (Exception e) {
+            return "unknown";
+        }
+    }
+
+    private static String prop(String key) {
+        try {
+            return (String) Class.forName("android.os.SystemProperties")
+                    .getMethod("get", String.class, String.class).invoke(null, key, "?");
+        } catch (Exception e) {
+            return "?";
+        }
+    }
+
+    /**
+     * Called once at process start. Writes a boot banner and returns the previous
+     * boot's tail so a crash that rebooted the phone is still readable.
+     */
+    static synchronized String bootBanner(Context ctx) {
+        String id = bootId();
+        boolean sameBoot = id.equals(lastBootId(ctx));
+        StringBuilder sb = new StringBuilder();
+        sb.append(String.format(Locale.US,
+                "* boot id %s%s%n* bootreason: ro.boot.bootreason=%s | sys.boot.reason=%s%n",
+                id, sameBoot ? " (same kernel boot as last run)" : " (NEW kernel boot)",
+                prop("ro.boot.bootreason"), prop("sys.boot.reason")));
+        if (!sameBoot) {
+            List<String> prev = tail(ctx, 14);
+            if (!prev.isEmpty()) {
+                sb.append("* last lines of the previous kernel boot (see ")
+                  .append(LOG_FILE).append("):").append(System.lineSeparator());
+                for (String s : prev) sb.append("  ").append(s).append(System.lineSeparator());
+            }
+        }
+        log(ctx, String.format(Locale.US, "=== BOOT id=%s ro.boot.bootreason=%s sys.boot.reason=%s ===",
+                id, prop("ro.boot.bootreason"), prop("sys.boot.reason")));
+        saveBootId(ctx, id);
+        return sb.toString();
+    }
+
+    private static String lastBootId(Context ctx) {
+        File f = new File(ctx.getFilesDir(), "last_boot_id");
+        try {
+            return f.exists() ? new String(Files.readAllBytes(f.toPath())).trim() : null;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static void saveBootId(Context ctx, String id) {
+        try {
+            Files.write(new File(ctx.getFilesDir(), "last_boot_id").toPath(),
+                    id.getBytes(StandardCharsets.UTF_8));
+        } catch (Exception ignored) {
+        }
+    }
+
+    // ---- marker watcher -------------------------------------------------------
+
+    /** Starts a daemon thread that appends every newly appearing marker to the log. */
+    static Thread watchMarkers(final Context ctx) {
+        Thread t = new Thread(new Runnable() {
+            @Override public void run() {
+                LinkedHashSet<String> seen = new LinkedHashSet<>();
+                for (Map.Entry<String, String> e : MARKERS.entrySet())
+                    if (new File(e.getKey()).exists()) note(ctx, seen, e, "already present");
+                while (!Thread.currentThread().isInterrupted()) {
+                    for (Map.Entry<String, String> e : MARKERS.entrySet()) {
+                        if (seen.contains(e.getKey())) continue;
+                        if (new File(e.getKey()).exists()) note(ctx, seen, e, "appeared");
+                    }
+                    try {
+                        Thread.sleep(150);
+                    } catch (InterruptedException ie) {
+                        return;
+                    }
+                }
+            }
+        }, "dfroot-markers");
+        t.setDaemon(true);
+        t.start();
+        return t;
+    }
+
+    private static void note(Context ctx, LinkedHashSet<String> seen,
+                             Map.Entry<String, String> e, String verb) {
+        seen.add(e.getKey());
+        String msg = "* marker " + e.getKey() + " " + verb + " - " + e.getValue();
+        log(ctx, msg);
+    }
+
+    /**
+     * bootstrap.c only creates dfm5/dfm6 long after the exploit process has exited
+     * (the libc++ hook fires when init reaps the orphaned grandchild), and upstream
+     * treats "bootstrap returned 0" as SUCCESS even when ksud itself failed: main()
+     * returns 0 in both branches. So wait for the real marker and judge by that.
+     */
+    static int awaitMarkers(Context ctx, IReporter rep, long timeoutMs) {
+        long end = System.currentTimeMillis() + timeoutMs;
+        while (System.currentTimeMillis() < end) {
+            if (new File("/dev/dfme2").exists()) {
+                rep.report("* ksud late-load reported an error (/dev/dfme2) - KernelSU was NOT installed\n");
+                return VERDICT_KSUD_FAIL;
+            }
+            if (new File("/dev/dfm6").exists()) {
+                rep.report("* ksud late-load finished cleanly (/dev/dfm6) - KernelSU is loaded\n");
+                return VERDICT_KSUD_OK;
+            }
+            try {
+                Thread.sleep(250);
+            } catch (InterruptedException ie) {
+                return VERDICT_STALLED;
+            }
+        }
+        List<String> seenMarkers = new ArrayList<>();
+        for (String m : MARKERS.keySet())
+            if (new File(m).exists()) seenMarkers.add(m);
+        rep.report("* timed out after " + (timeoutMs / 1000) + "s. markers present: "
+                + seenMarkers + "\n  If /dev/dfm5 is there but /dev/dfm6 is not, the kernel died inside"
+                + " ksud late-load (KernelSU module), not inside the exploit.\n");
+        return VERDICT_STALLED;
+    }
+
+    static String describeMarkers() {
+        StringBuilder sb = new StringBuilder();
+        for (Map.Entry<String, String> e : MARKERS.entrySet())
+            if (new File(e.getKey()).exists())
+                sb.append("  ").append(e.getKey()).append(" = ").append(e.getValue()).append(System.lineSeparator());
+        if (sb.length() == 0) sb.append("  (none - nothing of the chain ran in this kernel boot)").append(System.lineSeparator());
+        return sb.toString();
+    }
+}
